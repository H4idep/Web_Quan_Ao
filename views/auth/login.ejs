  <section class="signin">
    <div class="container">
      <div class="chua">
        <!-- CỘT TRÁI: ĐĂNG NHẬP -->
        <div class="content-signin">
          <h3>Bạn đã có tài khoản ROUTINE</h3>

          <p>
            Nếu bạn đã có tài khoản, hãy đăng nhập để tích lũy điểm thành viên
            và nhận được những ưu đãi tốt hơn!
          </p>

          <% if (success) { %>
            <div class="auth-notice auth-notice-success" role="status">
              <%= success %>
            </div>
            <% } %>

              <% if (error) { %>
                <div class="auth-notice auth-notice-error" role="alert">
                  <%= error %>
                </div>
                <% } %>

                  <div class="content-signin-bottom">
                    <form action="/login" method="POST">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

                      <label for="loginEmail">Email</label>
                      <br />

                      <input type="email" id="loginEmail" name="email" placeholder="Nhập email" value="<%= email %>"
                        autocomplete="email" maxlength="254" style="font-size: 16px" required />

                      <br />

                      <label for="loginPassword">Mật Khẩu</label>
                      <br />

                      <input type="password" id="loginPassword" name="password" placeholder="Nhập mật khẩu"
                        autocomplete="current-password" style="font-size: 16px" required />

                      <br />

                      <button type="submit">
                        <h4>ĐĂNG NHẬP</h4>
                      </button>
                    </form>
                  </div>
        </div>

        <!-- CỘT PHẢI: CHUYỂN ĐẾN ĐĂNG KÝ -->
        <div class="content-signin right">
          <h3>Khách hàng mới của ROUTINE</h3>

          <p>
            Nếu bạn chưa có tài khoản trên ROUTINE.com, hãy sử dụng tùy chọn
            này để truy cập biểu mẫu đăng ký.
          </p>

          <p>
            Bằng cách cung cấp cho ROUTINE thông tin chi tiết của bạn, quá
            trình mua hàng trên ROUTINE sẽ là một trải nghiệm thú vị và nhanh
            chóng hơn!
          </p>

          <form action="/register" method="GET">
            <button type="submit">
              <h4>ĐĂNG KÝ</h4>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
