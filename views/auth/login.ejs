<!doctype html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Đăng nhập | Routine</title>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <link rel="stylesheet" href="/css/auth-refresh.css">

  <script src="/js/login-password.js" defer></script>
</head>

<body class="routine-login-page">
  <%- include("../partials/header") %>

    <main class="routine-auth">
      <nav class="auth-breadcrumb" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Đăng nhập</span>
      </nav>

      <div class="routine-auth-grid">
        <section class="routine-login">
          <p class="auth-kicker">TÀI KHOẢN ROUTINE</p>

          <h1>Chào mừng bạn trở lại</h1>

          <p class="auth-description">
            Đăng nhập để quản lý tài khoản và theo dõi
            những đơn hàng của bạn.
          </p>

          <% if (success) { %>
            <div class="routine-auth-message success" role="status">
              <%= success %>
            </div>
            <% } %>

              <% if (error) { %>
                <div class="routine-auth-message error" role="alert">
                  <%= error %>
                </div>
                <% } %>

                  <form action="/login" method="POST" class="routine-login-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="routine-auth-field">
                      <label for="loginEmail">Email</label>

                      <input type="email" id="loginEmail" name="email" placeholder="Nhập địa chỉ email"
                        value="<%= email %>" autocomplete="username" maxlength="254" required>
                    </div>

                    <div class="routine-auth-field">
                      <label for="loginPassword">Mật khẩu</label>

                      <div class="routine-password">
                        <input type="password" id="loginPassword" name="password" placeholder="Nhập mật khẩu"
                          autocomplete="current-password" required>

                        <button type="button" id="loginPasswordToggle" aria-label="Hiện mật khẩu"
                          aria-controls="loginPassword" title="Hiện mật khẩu">
                          <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                      </div>
                    </div>

                    <button type="submit" class="routine-auth-button">
                      Đăng nhập
                      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </button>
                  </form>

                  <a href="/" class="auth-return">
                    ← Tiếp tục khám phá cửa hàng
                  </a>
        </section>

        <section class="routine-new-customer">
          <div class="auth-brand-mark" aria-hidden="true">R.</div>

          <p class="auth-kicker">DÀNH CHO KHÁCH HÀNG MỚI</p>

          <h2>Phong cách của bạn.<br>Hành trình cùng Routine.</h2>

          <p class="auth-description">
            Tạo tài khoản để mua sắm thuận tiện hơn
            và quản lý thông tin của bạn tại một nơi.
          </p>

          <ul class="auth-benefits">
            <li>
              <i class="fa-solid fa-check" aria-hidden="true"></i>
              Theo dõi đơn hàng đã đặt
            </li>
            <li>
              <i class="fa-solid fa-check" aria-hidden="true"></i>
              Lưu thông tin cho lần mua tiếp theo
            </li>
            <li>
              <i class="fa-solid fa-check" aria-hidden="true"></i>
              Quản lý tài khoản cá nhân
            </li>
          </ul>

          <a href="/register" class="routine-auth-button outline">
            Tạo tài khoản
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </a>
        </section>
      </div>
    </main>

    <%- include("../partials/footer") %>
</body>

</html>