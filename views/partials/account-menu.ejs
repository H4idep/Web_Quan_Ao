<li class="account-menu">
    <% if (!currentUser) { %>
        <a href="/login" class="fa-solid fa-circle-user" aria-label="Đăng nhập" title="Đăng nhập"></a>
        <% } else { %>
            <details class="account-dropdown">
                <summary aria-label="Mở menu tài khoản" title="<%= currentUser.fullName %>">
                    <i class="fa-solid fa-circle-user"></i>
                    <span class="account-online-dot"></span>
                </summary>

                <div class="account-dropdown-panel">
                    <strong>
                        <%= currentUser.fullName %>
                    </strong>

                    <small>
                        <%= currentUser.role==="admin" ? "Quản trị viên" : "Khách hàng" %>
                    </small>

                    <a href="/account">Thông tin tài khoản</a>

                    <a href="/orders">Đơn hàng của tôi</a>

                    <% if (currentUser.role==="admin" ) { %>
                        <a href="/admin">Trang quản trị</a>
                        <% } %>

                            <form action="/logout" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                <button type="submit">Đăng xuất</button>
                            </form>
                </div>
            </details>
            <% } %>
</li>