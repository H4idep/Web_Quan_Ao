<header>
    <div class="logo">
        <a href="/">
            <img src="/images/Logo-Rountine.webp" width="180" height="50" alt="Routine">
        </a>
    </div>
    <div class="menu">
        <% menuCategories.forEach(group=> { %>
            <li>
                <a href="/products?category=<%= group.id %>">
                    <%= group.name.toUpperCase() %>
                </a>

                <ul class="sub-menu">
                    <li>
                        <a href="/products?category=<%= group.id %>">
                            Xem tất cả
                        </a>
                    </li>

                    <% group.children.forEach(category=> { %>
                        <li>
                            <a href="/products?category=<%= category.id %>">
                                <%= category.name %>
                            </a>
                        </li>
                        <% }) %>
                </ul>
            </li>
            <% }) %>

                <li>
                    <a href="/about">THÔNG TIN</a>
                </li>
    </div>
    <div class="other">
        <li class="header-search-container">
            <form action="/products" method="GET" class="header-search-form" id="headerSearchForm" autocomplete="off">
                <input placeholder="Tìm kiếm..." type="text" name="q" id="headerSearchInput"
                    value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" />
                <button type="submit" class="search-submit-btn" aria-label="Tìm kiếm">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>

            <!-- Hộp dropdown hiển thị gợi ý kết quả -->
            <div class="search-suggest-dropdown" id="searchSuggestDropdown"></div>
        </li>

        <li>
            <a class="fa-solid fa-paw" href=""></a>
            <ul class="sub-menu sub-menu-social">
                <li><a href="">Hotline trực tuyến</a></li>
                <li><a href="">Messenger</a></li>
                <li><a href="">Email</a></li>
                <li><a href="">Facebook</a></li>
            </ul>
        </li>
        <%- include("account-menu") %>
            <li class="cart-link">
                <a class="fa-solid fa-cart-shopping" href="/cart" aria-label="Giỏ hàng"></a>
                <% if (typeof cartCount !=="undefined" && cartCount> 0) { %>
                    <span class="cart-badge">
                        <%= cartCount %>
                    </span>
                    <% } %>
            </li>
    </div>
</header>