<!doctype html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Giỏ hàng - Zody</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/cart.css">
    <script src="/js/cart.js" defer></script>
</head>

<body class="cart-page">
    <%- include("../partials/header") %>

        <main class="cart-container">
            <h1>Giỏ hàng của bạn</h1>

            <% if (flash) { %>
                <p class="cart-flash cart-flash-<%= flash.type %>" role="status">
                    <%= flash.message %>
                </p>
                <% } %>

                    <% if (items.length===0) { %>
                        <div class="cart-empty">
                            <p>Giỏ hàng đang trống.</p>
                            <a class="cart-btn" href="/products">Tiếp tục mua sắm</a>
                        </div>
                        <% } else { %>
                            <%# Form chọn sản phẩm để đặt. Các ô tích và nút Đặt hàng nằm ngoài form này nhưng gắn vào
                                nó bằng thuộc tính form="select-form" , vì HTML không cho lồng form (mỗi dòng đã có form
                                cập nhật/xóa riêng). %>
                                <form id="select-form" method="get" action="/checkout"></form>

                                <table class="cart-table">
                                    <thead>
                                        <tr>
                                            <th class="cart-select">
                                                <input type="checkbox" id="select-all" aria-label="Chọn tất cả sản phẩm"
                                                    <%=orderableCount> 0 ? "checked" : "disabled" %>>
                                            </th>
                                            <th>Sản phẩm</th>
                                            <th>Đơn giá</th>
                                            <th>Số lượng</th>
                                            <th>Thành tiền</th>
                                            <th><span class="visually-hidden">Xóa</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% items.forEach(item=> {
                                            const image = imagePath(item.image_url);
                                            const soldOut = Number(item.stock) <= 0; const overStock=!soldOut &&
                                                Number(item.quantity)> Number(item.stock);
                                                const canOrder = isOrderable(item);
                                                %>
                                                <tr>
                                                    <!-- Dòng 60-64 trong views/cart/index.ejs -->
                                                    <td class="cart-select">
                                                        <input type="checkbox" name="selected" form="select-form"
                                                            value="<%= item.id %>"
                                                            data-line-total="<%= item.line_total %>" <%=canOrder
                                                            ? "checked" : "disabled" %>
                                                        aria-label="Chọn <%= item.name %>">
                                                    </td>
                                                    <td class="cart-product">
                                                        <img src="<%= image %>" alt="<%= item.name %>" width="80"
                                                            height="100">
                                                        <div>
                                                            <a href="/products/<%= item.product_id %>"><strong>
                                                                    <%= item.name %>
                                                                </strong></a>
                                                            <% if (item.color || item.size) { %>
                                                                <p style="font-size: 13px; color: #555; margin: 4px 0;">
                                                                    Phân loại:
                                                                    <strong>
                                                                        <%= [item.color,
                                                                            item.size].filter(Boolean).join(" - ") %></strong>
            </p>
        <% } %>
        <% if (soldOut) { %>
            <small class=" cart-note">Hết hàng</small>
                                                                            <% } %>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <%= formatMoney(item.price) %>
                                                    </td>
                                                    <td>
                                                        <form method="post" action="/cart/update" class="cart-qty-form">
                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                            <input type="hidden" name="cartItemId"
                                                                value="<%= item.id %>">
                                                            <input type="number" name="quantity"
                                                                value="<%= item.quantity %>" min="1"
                                                                max="<%= maxPerItem %>">
                                                            <button type="submit">Cập nhật</button>
                                                        </form>
                                                    </td>
                                                    <td>
                                                        <%= formatMoney(item.line_total) %>
                                                    </td>
                                                    <td>
                                                        <form method="post" action="/cart/remove">
                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                            <input type="hidden" name="cartItemId"
                                                                value="<%= item.id %>">
                                                            <button type="submit" class="cart-remove-btn"
                                                                title="Xóa">&times;</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                    </tbody>
                                </table>

                                <div class="cart-summary">
                                    <p>
                                        Đã chọn <span id="selected-count">
                                            <%= orderableCount %>
                                        </span> sản phẩm:
                                        <strong id="selected-total">
                                            <%= formatMoney(orderableTotal) %>
                                        </strong>
                                    </p>

                                    <a class="cart-btn cart-btn-secondary" href="/products">Tiếp tục mua sắm</a>
                                    <button type="submit" form="select-form" id="checkout-btn" class="cart-btn"
                                        <%=orderableCount===0 ? "disabled" : "" %>>Đặt hàng</button>
                                </div>
                                <% } %>
        </main>

        <%- include("../partials/footer") %>
</body>

</html>