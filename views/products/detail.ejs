<!doctype html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>
        <%= product.name %> - Routine
    </title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/product-detail.css">

    <script src="/js/product-detail.js" defer></script>
</head>

<body class="product-detail-page">
    <% function imagePath(value) { if (typeof value !=="string" ) { return "" ; } let imageUrl=value.trim(); if
        (!imageUrl) { return "" ; } imageUrl=imageUrl.split("\\").join("/"); if ( imageUrl.startsWith("https://") ||
        imageUrl.startsWith("http://") ) { return imageUrl; } if (imageUrl.startsWith("//")) { return "" ; } if
        (imageUrl.startsWith("/")) { return imageUrl; } if (imageUrl.startsWith("./")) { imageUrl=imageUrl.slice(2); }
        if (imageUrl.startsWith("public/")) { imageUrl=imageUrl.slice(7); } if ( imageUrl.startsWith("images/") ||
        imageUrl.startsWith("uploads/") ) { return "/" + imageUrl; } return "" ; } const
        extraImages=Array.isArray(product.images) ? product.images : []; const galleryImages=Array.from( new Set(
        [product.image_url] .concat(extraImages) .map(imagePath) .filter(Boolean) ) ); const
        inStock=Number(product.stock)> 0;
        %>

        <main class="pd-container">
            <nav class="pd-breadcrumb" aria-label="Đường dẫn">
                <a href="/">Trang chủ</a>
                <span>/</span>
                <a href="/products">Sản phẩm</a>
                <span>/</span>
                <span aria-current="page">
                    <%= product.name %>
                </span>
            </nav>

            <div class="pd-layout">
                <!-- Ảnh sản phẩm -->
                <section class="pd-gallery" aria-label="Ảnh sản phẩm">
                    <div class="pd-main-photo">
                        <% if (galleryImages.length> 0) { %>
                            <img id="pd-main-image" src="<%= galleryImages[0] %>" alt="<%= product.name %>"
                                fetchpriority="high">

                            <p id="pd-image-error" class="pd-image-message" hidden>
                                Không tải được ảnh sản phẩm.
                            </p>
                            <% } else { %>
                                <p class="pd-image-message">
                                    Sản phẩm chưa có ảnh.
                                </p>
                                <% } %>
                    </div>

                    <% if (galleryImages.length> 0) { %>
                        <div class="pd-thumbnails" aria-label="Chọn ảnh sản phẩm">
                            <% galleryImages.forEach((url, index)=> { %>
                                <button type="button" class="pd-thumbnail <%= index === 0 ? 'is-active' : '' %>"
                                    data-image="<%= url %>" aria-label="Xem ảnh <%= index + 1 %>"
                                    aria-pressed="<%= index === 0 ? 'true' : 'false' %>">
                                    <img src="<%= url %>" alt="<%= product.name %> - ảnh <%= index + 1 %>"
                                        loading="lazy">
                                </button>
                                <% }) %>
                        </div>
                        <% } %>
                </section>

                <!-- Thông tin sản phẩm -->
                <section class="pd-info">
                    <p class="pd-category">
                        <%= product.category_name %>
                    </p>

                    <h1>
                        <%= product.name %>
                    </h1>

                    <p class="pd-code">
                        Mã sản phẩm: SP<%= product.id %>
                    </p>

                    <p class="pd-price">
                        <%= formatMoney(product.price) %>
                    </p>

                    <p class="pd-stock <%= inStock ? '' : 'is-sold-out' %>">
                        <span class="pd-stock-dot" aria-hidden="true"></span>

                        <% if (inStock) { %>
                            Còn hàng · <%= product.stock %> sản phẩm
                                <% } else { %>
                                    Tạm hết hàng
                                    <% } %>
                    </p>

                    <div class="pd-summary">
                        <span>Danh mục</span>
                        <strong>
                            <%= product.category_name %>
                        </strong>
                    </div>

                    <!-- KHUNG CHỌN MÀU SẮC & KÍCH CỠ -->
                    <% const variants=product.variants || []; const uniqueColors=[...new Set(variants.map(v=>
                        v.color))];
                        const uniqueSizes = [...new Set(variants.map(v => v.size))];
                        %>

                        <form class="pd-cart-form" id="addToCartForm" method="post" action="/cart/add">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="productId" value="<%= product.id %>">
                            <input type="hidden" name="variantId" id="selectedVariantId" value="">

                            <% if (variants.length> 0) { %>
                                <!-- Chọn Màu sắc -->
                                <div class="variant-group">
                                    <label class="variant-label">Màu sắc: <strong id="selectedColorText">Chọn
                                            màu</strong></label>
                                    <div class="variant-options">
                                        <% uniqueColors.forEach(color=> { %>
                                            <button type="button" class="variant-btn btn-color"
                                                data-color="<%= color %>">
                                                <%= color %>
                                            </button>
                                            <% }) %>
                                    </div>
                                </div>

                                <!-- Chọn Kích cỡ -->
                                <div class="variant-group">
                                    <label class="variant-label">Kích thước: <strong id="selectedSizeText">Chọn
                                            size</strong></label>
                                    <div class="variant-options">
                                        <% uniqueSizes.forEach(size=> { %>
                                            <button type="button" class="variant-btn btn-size" data-size="<%= size %>">
                                                <%= size %>
                                            </button>
                                            <% }) %>
                                    </div>
                                </div>
                                <% } %>

                                    <!-- Chọn số lượng -->
                                    <div class="pd-quantity-row">
                                        <label for="pd-quantity">Số lượng</label>
                                        <input id="pd-quantity" type="number" name="quantity" value="1" min="1" max="99"
                                            required>
                                    </div>
                                    <br>

                                    <!-- Nút đặt hàng và thông báo phía dưới -->
                                    <div class="pd-action-row">
                                        <button type="submit" id="btnAddToCart" class="pd-add-btn">
                                            Đặt hàng
                                        </button>
                                        <p id="variantStockNotice" class="pd-variant-notice">
                                            <%= variants.length> 0 ? "Vui lòng chọn size & màu" : "" %>
                                        </p>
                                    </div>
                        </form>

                        <!-- Nhúng dữ liệu biến thể vào thẻ script JSON để Client xử lý mượt mà -->
                        <script id="productVariantsData" type="application/json">
                        <%- JSON.stringify(variants) %>
                    </script>

                        <a class="pd-shop-link" href="/products">
                            Khám phá thêm sản phẩm
                            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                        </a>

                        <div class="pd-details">
                            <div class="pd-tabs" role="tablist" aria-label="Thông tin sản phẩm">
                                <button id="pd-description-tab" type="button" class="pd-tab is-active" role="tab"
                                    aria-selected="true" aria-controls="pd-description-panel" tabindex="0">
                                    Giới thiệu
                                </button>

                                <button id="pd-specs-tab" type="button" class="pd-tab" role="tab" aria-selected="false"
                                    aria-controls="pd-specs-panel" tabindex="-1">
                                    Chi tiết sản phẩm
                                </button>
                            </div>

                            <div id="pd-description-panel" class="pd-panel" role="tabpanel"
                                aria-labelledby="pd-description-tab" tabindex="0">
                                <p class="pd-description">
                                    <%= product.description || "Thông tin sản phẩm đang được cập nhật." %>
                                </p>
                            </div>

                            <div id="pd-specs-panel" class="pd-panel" role="tabpanel" aria-labelledby="pd-specs-tab"
                                tabindex="0" hidden>
                                <dl class="pd-specs">
                                    <div>
                                        <dt>Mã sản phẩm</dt>
                                        <dd>SP<%= product.id %>
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Danh mục</dt>
                                        <dd>
                                            <%= product.category_name %>
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Giá bán</dt>
                                        <dd>
                                            <%= formatMoney(product.price) %>
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Tình trạng</dt>
                                        <dd>
                                            <%= inStock ? "Còn hàng" : "Tạm hết hàng" %>
                                        </dd>
                                    </div>
                                </dl>
                            </div>
                        </div>
                </section>
            </div>
        </main>

        <%- include("../partials/footer") %>
</body>

</html>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const variantsDataEl = document.getElementById("productVariantsData");
        if (!variantsDataEl) return;

        const variants = JSON.parse(variantsDataEl.textContent || "[]");
        if (variants.length === 0) return;

        let selectedColor = "";
        let selectedSize = "";

        const form = document.getElementById("addToCartForm");
        const colorBtns = document.querySelectorAll(".btn-color");
        const sizeBtns = document.querySelectorAll(".btn-size");
        const hiddenVariantId = document.getElementById("selectedVariantId");
        const colorText = document.getElementById("selectedColorText");
        const sizeText = document.getElementById("selectedSizeText");
        const stockNotice = document.getElementById("variantStockNotice");
        const quantityInput = document.getElementById("pd-quantity");

        function updateState() {
            if (!selectedColor || !selectedSize) {
                stockNotice.innerText = "Vui lòng chọn size & màu";
                stockNotice.style.color = "#d32f2f";
                hiddenVariantId.value = "";
                return;
            }

            const match = variants.find(v => v.color === selectedColor && v.size === selectedSize);

            if (!match) {
                stockNotice.innerText = "Phiên bản màu/size này hiện không khả dụng.";
                stockNotice.style.color = "#d32f2f";
                hiddenVariantId.value = "";
            } else if (match.stock <= 0) {
                stockNotice.innerText = "Phân loại này hiện đã hết hàng.";
                stockNotice.style.color = "#d32f2f";
                hiddenVariantId.value = "";
            } else {
                stockNotice.innerText = `Còn ${match.stock} sản phẩm trong kho.`;
                stockNotice.style.color = "#2e7d32";
                hiddenVariantId.value = match.id;
                quantityInput.max = Math.min(match.stock, 99);
            }
        }

        colorBtns.forEach(btn => {
            btn.addEventListener("click", () => {
                colorBtns.forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                selectedColor = btn.dataset.color;
                colorText.innerText = selectedColor;
                updateState();
            });
        });

        sizeBtns.forEach(btn => {
            btn.addEventListener("click", () => {
                sizeBtns.forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                selectedSize = btn.dataset.size;
                sizeText.innerText = selectedSize;
                updateState();
            });
        });

        if (form) {
            form.addEventListener("submit", (e) => {
                if (!selectedColor || !selectedSize) {
                    e.preventDefault();
                    stockNotice.innerText = "Vui lòng chọn size & màu";
                    stockNotice.style.color = "#d32f2f";
                    return;
                }

                const match = variants.find(v => v.color === selectedColor && v.size === selectedSize);
                if (!match) {
                    e.preventDefault();
                    stockNotice.innerText = "Phiên bản màu/size này hiện không khả dụng.";
                    stockNotice.style.color = "#d32f2f";
                    return;
                }

                if (match.stock <= 0) {
                    e.preventDefault();
                    stockNotice.innerText = "Phân loại này hiện đã hết hàng.";
                    stockNotice.style.color = "#d32f2f";
                    return;
                }
            });
        }
    });
</script>