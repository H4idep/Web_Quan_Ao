<!doctype html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>
        <%= product.name %> - Routine
    </title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/store-products.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>

<body>
    <%- include("../partials/header") %>

        <main class="store-products">
            <p class="store-breadcrumb">
                <a href="/">Trang chủ</a>
                /
                <a href="/products">Sản phẩm</a>
                /
                <%= product.name %>
            </p>

            <div class="store-detail">
                <div class="store-detail-image">
                    <% if (product.image_url) { %>
                        <img src="<%= product.image_url %>" alt="<%= product.name %>">
                        <% } else { %>
                            <span>Chưa có ảnh sản phẩm</span>
                            <% } %>
                </div>

                <section class="store-detail-info">
                    <p class="store-category">
                        <%= product.category_name %>
                    </p>

                    <h1>
                        <%= product.name %>
                    </h1>

                    <p class="store-product-code">
                        Mã sản phẩm: <%= product.id %>
                    </p>

                    <p class="store-detail-price">
                        <%= formatMoney(product.price) %>
                    </p>

                    <% if (Number(product.stock)> 0) { %>
                        <p class="store-in-stock">Còn hàng</p>
                        <% } else { %>
                            <p class="store-out-of-stock">Sản phẩm đã hết hàng</p>
                            <% } %>

                                <div class="store-description">
                                    <h2>Mô tả sản phẩm</h2>
                                    <p>
                                        <%= product.description %>
                                    </p>
                                </div>

                                <a class="store-back" href="/products">
                                    ← Tiếp tục xem sản phẩm
                                </a>
                </section>
            </div>
        </main>

        <%- include("../partials/footer") %>
</body>

</html>