<!doctype html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Sản phẩm - Routine</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/store-products.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>

<body>
    <%- include("../partials/header") %>

        <main class="store-products">
            <div class="store-products-heading">
                <div>
                    <p>
                        <a href="/">Trang chủ</a> / Sản phẩm
                    </p>

                    <h1>Tất cả sản phẩm</h1>
                </div>

                <span>
                    <%= products.length %> sản phẩm
                </span>
            </div>

            <% if (products.length===0) { %>
                <p class="store-empty">
                    Cửa hàng đang cập nhật sản phẩm.
                    Bạn vui lòng quay lại sau.
                </p>
                <% } %>

                    <div class="store-product-grid">
                        <% products.forEach(product=> { %>
                            <article class="store-product-card">
                                <a href="/products/<%= product.id %>" class="store-product-image">
                                    <% if (product.image_url) { %>
                                        <img src="<%= product.image_url %>" alt="<%= product.name %>" loading="lazy">
                                        <% } else { %>
                                            <span>Chưa có ảnh</span>
                                            <% } %>
                                </a>

                                <p class="store-category">
                                    <%= product.category_name %>
                                </p>

                                <h2>
                                    <a href="/products/<%= product.id %>">
                                        <%= product.name %>
                                    </a>
                                </h2>

                                <p class="store-price">
                                    <%= formatMoney(product.price) %>
                                </p>

                                <% if (Number(product.stock)===0) { %>
                                    <p class="store-out-of-stock">Hết hàng</p>
                                    <% } %>
                            </article>
                            <% }) %>
                    </div>
        </main>

        <%- include("../partials/footer") %>
</body>

</html>