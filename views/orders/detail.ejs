<!doctype html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đơn hàng <%= order.order_number %> - Zody</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/cart.css">
    <link rel="stylesheet" href="/css/checkout.css">
    <script src="/js/orders.js" defer></script>
</head>

<body class="cart-page">
    <%- include("../partials/header") %>

        <main class="cart-container">
            <p class="order-back"><a href="/orders">&larr; Đơn hàng của tôi</a></p>

            <% if (flash) { %>
                <p class="cart-flash cart-flash-<%= flash.type %>" role="status">
                    <%= flash.message %>
                </p>
                <% } %>

                    <h1>Đơn hàng <%= order.order_number %>
                    </h1>

                    <% if (order.status==="cancelled" ) { %>
                        <p class="order-cancelled-note">Đơn hàng này đã được hủy.</p>
                        <% } else { %>
                            <ol class="order-steps" aria-label="Tiến trình đơn hàng">
                                <% steps.forEach((step, index)=> { %>
                                    <li class="<%= index < currentStep ? " done" : "" %>
                                        <%= index===currentStep ? "current" : "" %>"
                                            <%- index===currentStep ? 'aria-current="step"' : "" %>><%= step.label %>
                                    </li>
                                    <% }) %>
                            </ol>
                            <% } %>

                                <dl class="order-info">
                                    <dt>Trạng thái</dt>
                                    <dd><span class="order-status order-status-<%= order.status %>">
                                            <%= statusLabel %>
                                        </span></dd>

                                    <dt>Ngày đặt</dt>
                                    <dd>
                                        <%= new Date(order.created_at).toLocaleString("vi-VN", {
                                            timeZone: "Asia/Ho_Chi_Minh" }) %>
                                    </dd>

                                    <dt>Người nhận</dt>
                                    <dd>
                                        <%= order.customer_name %> · <%= order.customer_phone %>
                                    </dd>

                                    <dt>Địa chỉ giao hàng</dt>
                                    <dd>
                                        <%= order.shipping_address %>
                                    </dd>

                                    <% if (order.notes) { %>
                                        <dt>Ghi chú</dt>
                                        <dd>
                                            <%= order.notes %>
                                        </dd>
                                        <% } %>
                                </dl>

                                <section class="payment-box">
                                    <h2>Thanh toán</h2>
                                    <dl class="order-info">
                                        <dt>Phương thức</dt>
                                        <dd>
                                            <%= paymentMethodLabel %>
                                        </dd>

                                        <dt>Tình trạng</dt>
                                        <dd>
                                            <span class="order-status order-status-pay-<%= order.payment_status %>">
                                                <%= paymentStatusText %>
                                            </span>
                                            <% if (order.payment_status==="paid" && order.paid_at) { %>
                                                lúc <%= new Date(order.paid_at).toLocaleString("vi-VN", {
                                                    timeZone: "Asia/Ho_Chi_Minh" }) %>
                                                    <% } %>
                                        </dd>
                                    </dl>

                                    <% if (awaitingTransfer) { %>
                                        <% if (bankTransferEnabled) { %>
                                            <div class="bank-box">
                                                <p>Vui lòng chuyển khoản <strong>đúng số tiền</strong> và <strong>đúng
                                                        nội dung</strong> bên dưới để cửa hàng đối soát đơn của bạn.</p>
                                                <dl class="order-info">
                                                    <dt>Ngân hàng</dt>
                                                    <dd>
                                                        <%= bank.name %>
                                                    </dd>

                                                    <dt>Số tài khoản</dt>
                                                    <dd>
                                                        <%= bank.accountNumber %>
                                                    </dd>

                                                    <dt>Chủ tài khoản</dt>
                                                    <dd>
                                                        <%= bank.accountName %>
                                                    </dd>

                                                    <dt>Số tiền</dt>
                                                    <dd><strong>
                                                            <%= formatMoney(order.total_amount) %>
                                                        </strong></dd>

                                                    <dt>Nội dung chuyển khoản</dt>
                                                    <dd><strong>
                                                            <%= order.order_number %>
                                                        </strong></dd>
                                                </dl>
                                                <% if (qrUrl) { %>
                                                    <img class="bank-qr" src="<%= qrUrl %>"
                                                        alt="Mã QR chuyển khoản cho đơn <%= order.order_number %>"
                                                        width="220" height="220">
                                                    <% } %>
                                                        <p class="checkout-note">Sau khi cửa hàng nhận được tiền, tình
                                                            trạng thanh toán sẽ chuyển thành "Đã thanh toán".</p>
                                            </div>
                                            <% } else { %>
                                                <p class="checkout-note">Vui lòng liên hệ cửa hàng để nhận thông tin
                                                    chuyển khoản cho đơn này.</p>
                                                <% } %>
                                                    <% } %>
                                </section>

                                <table class="cart-table">
                                    <thead>
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th>Đơn giá</th>
                                            <th>Số lượng</th>
                                            <th>Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% order.items.forEach(item=> { %>
                                            <tr>
                                                <td>
                                                    <strong>
                                                        <%= item.product_name %>
                                                    </strong>
                                                    <% if (item.color || item.size) { %>
                                                        <br>
                                                        <small style="color: #666;">Phân loại: <%= [item.color,
                                                                item.size].filter(Boolean).join(" - ") %></small>
                                                    <% } %>
                                                    </td>
                                                <td><%= formatMoney(item.unit_price) %></td>
                                                <td><%= item.quantity %></td>
                                                <td><%= formatMoney(item.line_total) %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>

                                <div class=" cart-summary">
                                                                <% const subtotal=order.items.reduce((sum, item)=> sum +
                                                                    Number(item.line_total),
                                                                    0); %>

                                                                    <% if (order.coupon_code &&
                                                                        Number(order.discount_amount)> 0) { %>
                                                                        <p
                                                                            style="font-size: 15px; color: #555; margin-bottom: 6px;">
                                                                            Tạm tính: <span>
                                                                                <%= formatMoney(subtotal) %>
                                                                            </span>
                                                                        </p>
                                                                        <p
                                                                            style="font-size: 15px; color: #2e7d32; margin-bottom: 8px;">
                                                                            Giảm giá (<strong
                                                                                style="text-transform: uppercase;">
                                                                                <%= order.coupon_code %>
                                                                            </strong>):
                                                                            <strong>-<%=
                                                                                    formatMoney(order.discount_amount)
                                                                                    %></strong>
                                                                        </p>
                                                                        <% } %>

                                                                            <p
                                                                                style="border-top: 1px dashed #ddd; padding-top: 8px; margin-top: 6px;">
                                                                                Tổng thanh toán: <strong>
                                                                                    <%= formatMoney(order.total_amount)
                                                                                        %>
                                                                                </strong>
                                                                            </p>

                                                                            <% if (canCancel) { %>
                                                                                <form method="post"
                                                                                    action="/orders/<%= order.order_number %>/cancel"
                                                                                    class="order-cancel-form"
                                                                                    data-confirm="Bạn chắc chắn muốn hủy đơn hàng này?">
                                                                                    <input type="hidden" name="_csrf"
                                                                                        value="<%= csrfToken %>">
                                                                                    <button type="submit"
                                                                                        class="cart-btn cart-btn-danger">Hủy
                                                                                        đơn
                                                                                        hàng</button>
                                                                                </form>
                                                                                <% } else if (paidAndPending) { %>
                                                                                    <p class="checkout-note">Đơn đã
                                                                                        thanh toán. Nếu muốn hủy, vui
                                                                                        lòng liên hệ cửa hàng để được
                                                                                        hoàn tiền.</p>
                                                                                    <% } else if
                                                                                        (order.status==="processing" ||
                                                                                        order.status==="shipped" ) { %>
                                                                                        <p class="checkout-note">Đơn
                                                                                            đang được xử lý nên không
                                                                                            thể
                                                                                            tự hủy. Hãy liên hệ cửa hàng
                                                                                            nếu cần hỗ trợ.</p>
                                                                                        <% } %>
                                                                                            <a class="cart-btn cart-btn-secondary"
                                                                                                href="/products">Tiếp
                                                                                                tục mua sắm</a>
                                                                                            </div>
        </main>

        <%- include("../partials/footer") %>
</body>

</html>