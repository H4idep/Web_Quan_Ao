<!doctype html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f7f9f6">
    <title><%= title %> | Zody Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/admin-refresh.css">
    <script src="/js/admin.js" defer></script>
</head>

<body class="admin-app">
    <aside class="sidebar" id="adminSidebar">
        <a class="brand" href="/admin" aria-label="Zody — Tổng quan quản trị">
            <svg class="brand-logo" viewBox="0 0 174 44" aria-hidden="true">
                <rect x="2" y="3" width="38" height="38" rx="12" fill="#e9f2ea" stroke="#d7e5d8"/>
                <text x="21" y="31" text-anchor="middle" fill="#245b3d" font-family="Arial, sans-serif" font-size="25" font-weight="700">Z</text>
                <text x="51" y="21" fill="#20372a" font-family="Arial, sans-serif" font-size="17" font-weight="700" letter-spacing="1.7">ZODY</text>
                <text x="52" y="34" fill="#718078" font-family="Arial, sans-serif" font-size="7.5" font-weight="600" letter-spacing=".8">QUẢN TRỊ CỬA HÀNG</text>
            </svg>
        </a>

        <p class="nav-label">KHÔNG GIAN LÀM VIỆC</p>
        <nav aria-label="Điều hướng quản trị">
            <a href="/admin" class="<%= active === 'dashboard' ? 'active' : '' %>" <%= active === 'dashboard' ? 'aria-current="page"' : '' %>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/></svg>
                <span>Tổng quan</span>
            </a>
            <a href="/admin/products" class="<%= active === 'products' ? 'active' : '' %>" <%= active === 'products' ? 'aria-current="page"' : '' %>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8.5 12 4l8 4.5v9L12 22l-8-4.5v-9Z"/><path d="m4.5 8.7 7.5 4.2 7.5-4.2M12 13v8.5"/></svg>
                <span>Sản phẩm</span>
            </a>
            <a href="/admin/categories" class="<%= active === 'categories' ? 'active' : '' %>" <%= active === 'categories' ? 'aria-current="page"' : '' %>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h16"/><circle cx="8" cy="5" r="2"/><circle cx="16" cy="12" r="2"/><circle cx="10" cy="19" r="2"/></svg>
                <span>Danh mục</span>
            </a>
            <a href="/admin/customers" class="<%= active === 'customers' ? 'active' : '' %>" <%= active === 'customers' ? 'aria-current="page"' : '' %>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M3 20v-1.5a6 6 0 0 1 12 0V20M16 5.2a3.5 3.5 0 0 1 0 6.6M18 14a5 5 0 0 1 3 4.5V20"/></svg>
                <span>Khách hàng</span>
            </a>
            <a href="/admin/orders" class="<%= active === 'orders' ? 'active' : '' %>" <%= active === 'orders' ? 'aria-current="page"' : '' %>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
                <span>Đơn hàng</span>
            </a>
            <a href="/admin/reports" class="<%= active === 'reports' ? 'active' : '' %>" <%= active === 'reports' ? 'aria-current="page"' : '' %>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5M4 19h17"/><path d="m7 15 4-4 3 2 6-7"/></svg>
                <span>Báo cáo doanh thu</span>
            </a>
        </nav>

        <div class="sidebar-bottom">
            <a class="store-link" href="/">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10h18l-1.5 10h-15L3 10Z"/><path d="M5 10 7 4h10l2 6M9 10v2a3 3 0 0 0 6 0v-2"/></svg>
                Xem cửa hàng
            </a>
            <div class="sidebar-profile">
                <span class="profile-avatar" aria-hidden="true"><%= currentUser.fullName.charAt(0).toUpperCase() %></span>
                <span class="profile-copy">
                    <strong><%= currentUser.fullName %></strong>
                    <small>Quản trị viên</small>
                </span>
                <form action="/logout" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="logout-icon" type="submit" aria-label="Đăng xuất" title="Đăng xuất">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5v16h5M14 8l4 4-4 4M8 12h10"/></svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>
    <button class="sidebar-backdrop" type="button" aria-label="Đóng điều hướng" tabindex="-1"></button>

    <div class="workspace">
        <header class="topbar">
            <button class="menu-toggle" type="button" aria-label="Mở điều hướng" aria-controls="adminSidebar" aria-expanded="false">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <nav class="breadcrumbs" aria-label="Đường dẫn">
                <a href="/admin">Quản trị</a>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
                <span><%= title %></span>
            </nav>

            <form class="admin-search" action="/admin/products" method="GET" role="search">
                <button class="search-toggle" type="button" aria-label="Mở tìm kiếm">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
                </button>
                <input type="search" name="q" placeholder="Tìm sản phẩm..." aria-label="Tìm sản phẩm trong quản trị">
                <kbd aria-hidden="true">Ctrl K</kbd>
            </form>

            <a class="notification-link" href="/admin/orders?status=pending" aria-label="Đơn hàng chờ xử lý">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4"/></svg>
                <% if (active === 'dashboard' && typeof stats !== 'undefined' && Number(stats.pendingCount) > 0) { %>
                    <span class="notification-dot" aria-hidden="true"></span>
                <% } %>
            </a>

            <div class="topbar-user">
                <span class="avatar"><%= currentUser.fullName.charAt(0).toUpperCase() %></span>
                <span class="topbar-user-name"><%= currentUser.fullName %></span>
            </div>
        </header>

        <main class="main">
            <div class="page-heading">
                <div>
                    <p class="eyebrow">CỬA HÀNG / <%= title.toUpperCase() %></p>
                    <h1><%= title %></h1>
                    <% if (active === 'dashboard') { %>
                        <p class="page-description">Theo dõi hiệu quả cửa hàng và những việc cần ưu tiên hôm nay.</p>
                    <% } %>
                </div>
                <% if (active === 'dashboard') { %>
                    <a class="btn primary add-product-btn" href="/admin/products/create">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        Thêm sản phẩm
                    </a>
                <% } %>
            </div>

            <% if (flash) { %>
                <div class="alert <%= flash.type %>" role="status"><%= flash.message %></div>
            <% } %>
